{
  "name": "immichpager",
  "version": "0.2.0",
  "description": "Persistent, customizable client album pages for Immich. Self-hosted with Docker.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": "git+https://gitlab.com/wispd/ImmichPager.git",
  "keywords": [
    "immich",
    "immich-extension",
    "immich-addon",
    "photo-gallery",
    "client-gallery",
    "self-hosted",
    "docker"
  ],
  "engines": {
    "node": ">=22.23 <23"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "dev:demo": "node scripts/demo.mjs",
    "build": "vite build",
    "bundle:runtime": "node scripts/bundle-runtime.mjs",
    "start": "node server/index.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:compat": "node scripts/check-compatibility.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@immich/ui": "0.86.0",
    "@mdi/js": "7.4.47",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.2",
    "css-tree": "^3.2.1",
    "sharp": "0.35.5",
    "svelte": "5.56.9",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.0",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/css-tree": "^3.2.0",
    "@types/node": "22.19.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte-check": "4.3.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
