# Build with the context produced by: pnpm build && pnpm bundle:runtime
# Install target dependencies with native build-platform tooling, avoiding emulated Node.
FROM --platform=$BUILDPLATFORM node:22.23.3-bookworm-slim AS dependencies
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV SHARP_IGNORE_GLOBAL_LIBVIPS=1
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.28.5 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
ARG TARGETARCH
# These pinned runtime dependencies ship prebuilt native packages. Lifecycle scripts
# would otherwise detect the build CPU and replace target binaries with host ones.
RUN case "$TARGETARCH" in amd64) pager_cpu=x64 ;; arm64) pager_cpu=arm64 ;; *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; esac \
    && NODE_OPTIONS=--max-old-space-size=256 pnpm install --prod --frozen-lockfile --ignore-scripts --cpu="$pager_cpu" --os=linux --libc=glibc
RUN mkdir /data && chown node:node /data

FROM node:22.23.3-bookworm-slim
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="ImmichPager" \
      org.opencontainers.image.description="Persistent, customizable client album pages for Immich. Self-hosted with Docker." \
      org.opencontainers.image.source="https://gitlab.com/wispd/ImmichPager" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.version=$VERSION \
      org.opencontainers.image.revision=$REVISION
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --from=dependencies /app/node_modules ./node_modules
COPY build ./build
COPY server ./server
COPY LICENSE NOTICE ./
COPY --from=dependencies --chown=node:node /data /data
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 DATA_DIR=/data BODY_SIZE_LIMIT=6M
USER node
EXPOSE 3000
VOLUME /data
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:3000/page/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/index.mjs"]
